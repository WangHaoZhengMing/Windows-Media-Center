<?xml version="1.0" encoding="UTF-8"?>
<!-- Self-authored parser fixture, independent from demo song selection. -->
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata">
  <head>
    <metadata>
      <ttm:agent xml:id="voice-a" type="person"/>
      <ttm:agent xml:id="voice-b" type="person"/>
    </metadata>
  </head>
  <body>
    <div>
      <p begin="0s" end="8s" ttm:agent="voice-a">
        <span begin="0s" end="1s">当</span>
        <span begin="1s" end="2s">夜色</span>
        <span begin="2s" end="3s">慢慢</span>
        <span begin="3s" end="4s">落下</span>
        <span begin="1s" end="7s" ttm:role="x-bg">轻轻唱着回响</span>
      </p>
      <p begin="2s" end="8s" ttm:agent="voice-b">
        <span begin="0s" end="2s">让音乐</span>
        <span begin="2s" end="4s">留在身旁</span>
      </p>
      <p begin="12s" end="16s" ttm:agent="voice-a voice-b">
        <span begin="0s" end="4s">一起唱</span>
      </p>
    </div>
  </body>
</tt>
